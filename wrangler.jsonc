{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "covid-wastewater-bluesky",
  "main": "src/index.ts",
  // Set this to today's date
  "compatibility_date": "2026-09-23",
  "observability": {
    "enabled": true
  },
  "vars": {
    "BLOCK_REPLIES": "true",
    "MAX_ATTEMPTS": "3",
    "PAUSE_BETWEEN_ATTEMPTS": "3000",
    "JSON_URL": "https://data.cdc.gov/resource/atcp-73re.json"
  },
  "workflows": [
    {
      "name": "covid-wastewater-bluesky-workflow",
      "binding": "COVID_WASTEWATER_BLUESKY_WORKFLOW",
      "class_name": "CovidWastewaterBlueskyWorkflow",
      // Saturday 00:01 UTC (Friday evening US time), after the CDC's weekly update
      "schedules": ["1 0 * * 6", "2 13 * * 1"]
    }
  ]
}
